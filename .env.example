# Public URL of the site (links in emails, metadata)
NEXT_PUBLIC_SITE_URL=https://izipass.myrzan.com

# Postgres (Neon via Vercel → Storage sets this automatically)
DATABASE_URL=

# 32+ random characters; signs the session cookie.  openssl rand -base64 32
SESSION_SECRET=

# Telegram sign-in: bot from @BotFather, with /setdomain set to the site's domain.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT=izipass_bot
# The same bot sends receipts to organizers and tickets to attendees; its webhook is set on each production build.
# Local testing only: point the bot at a fake Bot API server.
# TELEGRAM_API_URL=http://localhost:3300

# Email sign-in links via Resend. Without the key (local dev) links are printed to the console.
RESEND_API_KEY=
EMAIL_FROM="izipass <login@izipass.myrzan.com>"
# Local `next start` only: log sign-in links instead of sending. Never set on Vercel.
# EMAIL_LOG_ONLY=1

# Protects /api/cron (daily: expire unpaid holds, purge old receipts). Vercel sends it automatically.
CRON_SECRET=

# Wallet pass service (the wallet.myrzan.com project signs Apple/Google tickets).
WALLET_API_URL=https://wallet.myrzan.com
WALLET_API_KEY=
# Optional: signs ticket QR codes; falls back to SESSION_SECRET.
TICKET_SECRET=

# Test stand only (test.izipass.myrzan.com, its own Vercel project and database):
# no emails are sent (the sign-in link is shown on screen), ready-made test accounts sign in
# with one click, and a "Test stand" strip shows on every page. Never set it on production.
# TEST_STAND=1
